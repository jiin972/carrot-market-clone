generator client {
  provider = "prisma-client-js" //프로바이더 js용으로 선택
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

//DB 모델 정의
model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  email      String?    @unique
  password   String?
  phone      String?    @unique
  github_id  String?    @unique
  avatar     String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  smstokens  SMSToken[]
  products   Product[]
  post       Post[] //post는 user가 작성함
  comments   Comment[] //Comment는 user가 작성함
  likes      Like[]
  // chatRoom   ChatRoom?  @relation(fields: [chatRoomId], references: [id])
  chatRoom   ChatRoom[] //Many-to-Many 로 ChatRoom생성
  chatRoomId String?
  messages   Message[]
  purchases  Purchase[] //판매완료 여부 역참조

  reviewsGiven    Review[] @relation("reviewFrom")
  reviewsReceived Review[] @relation("reviewTo")
}

model SMSToken {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  token      String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int

  @@unique([token, phone]) //토큰, 폰 인증을 위한 복합유니크 사용
}

// ProductStatus 에 enum을 통해 정해진 값만 허용
enum ProductStatus {
  for_sale
  reserved
  sold
}

model Product {
  id          Int           @id @default(autoincrement())
  title       String
  price       Float
  description String
  photo       String
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int //항상 판매자, 상품 등록 시 결정, 고정값
  buyerId     Int? //항상 구매자, 처음엔 null/ 구매자 결정시 채워짐
  status      ProductStatus @default(for_sale) //물건 판매/예약/완료 상태표시
  purchases   Purchase[]
  chatRooms   ChatRoom[] //Procut와 연결된 chatRoom 역참조
  reviews     Review[]
}

//Post DB모델 정의
model Post {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  views       Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade) //Post와 User의 rerationShip정의
  userId   Int
  comments Comment[] //Comment는 특정 post에 작성됨
  likes    Like[]
}

model Comment {
  id      Int    @id @default(autoincrement())
  payload String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  userId     Int //Comment는 user가 작성
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId     Int //Comment는 특정 post에 작성
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Like {
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId     Int
  postId     Int

  @@id(name: "id", [userId, postId])
}

model ChatRoom {
  id        String   @id @default(cuid()) //예측 불가능한 String ID로 보안 강화
  users     User[] //ChatRoom에 원하는 만큼 user추가 가능
  productId Int? // updateProductState 함수를 실행하기 위해 productId필요
  product   Product? @relation(fields: [productId], references: [id]) // 상품정보를 얻기위해 Product와 relation연결

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  messages   Message[]
}

model Message {
  id      Int    @id @default(autoincrement())
  payload String //전달될 메시지

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  room       ChatRoom @relation(fields: [chatRoomId], references: [id]) //특정 chatroom으로 전송
  user       User     @relation(fields: [userId], references: [id])
  chatRoomId String
  userId     Int
}

//물건 판매완료 처리를 위한 모델정의
model Purchase {
  id        Int      @id @default(autoincrement())
  productId Int //판매된 상품
  userId    Int //구매한 사람
  create_at DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

//리뷰 작성을 위한 모델정의
model Review {
  id           Int      @id @default(autoincrement())
  payload      String
  rating       Int      @default(0)
  create_at    DateTime @default(now())
  //Product와의 관계(어떤 상품에 대한 리뷰인지)
  productId    Int //DB저장용 숫자
  product      Product  @relation(fields: [productId], references: [id]) //통로
  //리뷰 작성자
  createdById  Int
  createdBy    User     @relation("reviewFrom", fields: [createdById], references: [id])
  //리뷰 수신자(상대방 )
  createdForId Int
  createdFor   User     @relation("reviewTo", fields: [createdForId], references: [id])

  //복합unique사용(해당 필드 조합이 테이블 전체에 하나만 존재)
  @@unique([productId, createdById])
}
